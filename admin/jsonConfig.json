{
	"i18n": true,
	"type": "panel",
	"label": "iometer adapter settings",
	"items": {
		"iometerIp": {
			"type": "text",
			"label": "iometer IP address",
			"placeholder": "192.168.1.100",
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 6,
			"xl": 6,
			"validator": "/^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}$/.test(data.iometerIp)",
			"validatorErrorText": "Please enter a valid IP address",
			"validatorNoSaveOnError": true
		}
	}
}
