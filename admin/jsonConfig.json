{
	"i18n": true,
	"type": "panel",
	"items": {
		"iometerIp": {
			"type": "text",
			"label": "iometer IP address",
			"placeholder": "192.168.1.100",
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 6,
			"xl": 6,
			"validator": "/^(?:\\d{1,3}\\.){3}\\d{1,3}$/.test(data.iometerIp)",
			"validatorErrorText": "Please enter a valid IP address",
			"validatorNoSaveOnError": true
		}
	}
}
